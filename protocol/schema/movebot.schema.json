{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:movebot:protocol:0.1",
  "title": "MoveBot wire protocol v0.1",
  "description": "Every WebSocket text frame is one JSON object matching exactly one of these message kinds. See protocol/SPEC.md.",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    },
    {
      "$ref": "#/$defs/hello"
    },
    {
      "$ref": "#/$defs/event"
    },
    {
      "$ref": "#/$defs/telemetry"
    }
  ],
  "$defs": {
    "id": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        {
          "type": "integer"
        }
      ]
    },
    "plan_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "unit_interval": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "positive": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 600000
    },
    "light_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "status_pattern": {
      "enum": [
        "off",
        "on",
        "blink",
        "blink_fast",
        "pulse"
      ]
    },
    "topic": {
      "oneOf": [
        {
          "enum": [
            "odom",
            "encoders",
            "power",
            "net",
            "status"
          ]
        },
        {
          "type": "string",
          "pattern": "^module\\.[a-z][a-z0-9_]{0,31}$"
        }
      ]
    },
    "plan_state": {
      "enum": [
        "loaded",
        "running",
        "paused",
        "done",
        "failed",
        "cancelled"
      ]
    },
    "on_disconnect": {
      "enum": [
        "continue",
        "finish_step",
        "stop"
      ]
    },
    "error_code": {
      "enum": [
        "bad_request",
        "unknown_command",
        "invalid_param",
        "invalid_state",
        "busy",
        "unknown_plan",
        "unknown_module",
        "gap",
        "not_supported",
        "internal"
      ]
    },
    "pose": {
      "type": "object",
      "required": [
        "x",
        "y",
        "yaw"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "yaw": {
          "type": "number"
        }
      }
    },
    "step": {
      "type": "object",
      "required": [
        "seq",
        "op"
      ],
      "properties": {
        "seq": {
          "$ref": "#/$defs/seq"
        },
        "op": {
          "type": "string"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        }
      },
      "oneOf": [
        {
          "properties": {
            "op": {
              "const": "drive"
            },
            "dist": {
              "type": "number",
              "minimum": -100,
              "maximum": 100
            },
            "speed": {
              "$ref": "#/$defs/positive"
            }
          },
          "required": [
            "dist"
          ]
        },
        {
          "properties": {
            "op": {
              "enum": [
                "turn",
                "turn_to"
              ]
            },
            "yaw": {
              "type": "number",
              "minimum": -62.84,
              "maximum": 62.84
            },
            "speed": {
              "$ref": "#/$defs/positive"
            }
          },
          "required": [
            "yaw"
          ]
        },
        {
          "properties": {
            "op": {
              "const": "arc"
            },
            "radius": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "angle": {
              "type": "number",
              "minimum": -62.84,
              "maximum": 62.84
            },
            "speed": {
              "$ref": "#/$defs/positive"
            }
          },
          "required": [
            "radius",
            "angle"
          ]
        },
        {
          "properties": {
            "op": {
              "const": "drive_for"
            },
            "v": {
              "type": "number"
            },
            "w": {
              "type": "number"
            },
            "ms": {
              "$ref": "#/$defs/duration_ms"
            }
          },
          "required": [
            "v",
            "w",
            "ms"
          ]
        },
        {
          "properties": {
            "op": {
              "const": "wait"
            },
            "ms": {
              "$ref": "#/$defs/duration_ms"
            }
          },
          "required": [
            "ms"
          ]
        },
        {
          "properties": {
            "op": {
              "const": "light"
            },
            "name": {
              "$ref": "#/$defs/light_name"
            },
            "level": {
              "$ref": "#/$defs/unit_interval"
            }
          },
          "required": [
            "name",
            "level"
          ]
        },
        {
          "properties": {
            "op": {
              "const": "status"
            },
            "name": {
              "$ref": "#/$defs/light_name"
            },
            "pattern": {
              "$ref": "#/$defs/status_pattern"
            }
          },
          "required": [
            "name",
            "pattern"
          ]
        },
        {
          "properties": {
            "op": {
              "const": "speed"
            },
            "linear": {
              "$ref": "#/$defs/positive"
            },
            "angular": {
              "$ref": "#/$defs/positive"
            }
          },
          "anyOf": [
            {
              "required": [
                "linear"
              ]
            },
            {
              "required": [
                "angular"
              ]
            }
          ]
        },
        {
          "properties": {
            "op": {
              "const": "marker"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "required": [
            "label"
          ]
        },
        {
          "properties": {
            "op": {
              "const": "stop"
            }
          }
        }
      ]
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      },
      "maxItems": 256
    },
    "request": {
      "type": "object",
      "required": [
        "type",
        "id",
        "cmd"
      ],
      "properties": {
        "type": {
          "const": "req"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "cmd": {
          "type": "string",
          "pattern": "^[a-z_]+(\\.[a-z_]+)*$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "cmd": {
                "const": "motor.write"
              }
            }
          },
          "then": {
            "required": [
              "left",
              "right"
            ],
            "properties": {
              "left": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              "right": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cmd": {
                "const": "drive.velocity"
              }
            }
          },
          "then": {
            "required": [
              "v",
              "w"
            ],
            "properties": {
              "v": {
                "type": "number"
              },
              "w": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cmd": {
                "const": "speed.set"
              }
            }
          },
          "then": {
            "properties": {
              "linear": {
                "$ref": "#/$defs/positive"
              },
              "angular": {
                "$ref": "#/$defs/positive"
              }
            },
            "anyOf": [
              {
                "required": [
                  "linear"
                ]
              },
              {
                "required": [
                  "angular"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "cmd": {
                "const": "light.set"
              }
            }
          },
          "then": {
            "required": [
              "name",
              "level"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/light_name"
              },
              "level": {
                "$ref": "#/$defs/unit_interval"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cmd": {
                "const": "status.set"
              }
            }
          },
          "then": {
            "required": [
              "name",
              "pattern"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/light_name"
              },
              "pattern": {
                "$ref": "#/$defs/status_pattern"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cmd": {
                "const": "wifi.set"
              }
            }
          },
          "then": {
            "required": [
              "ssid"
            ],
            "properties": {
              "ssid": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "password": {
                "type": "string",
                "maxLength": 64
              },
              "ip": {
                "type": "string",
                "maxLength": 15
              },
              "gateway": {
                "type": "string",
                "maxLength": 15
              },
              "netmask": {
                "type": "string",
                "maxLength": 15
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cmd": {
                "enum": [
                  "sub",
                  "unsub"
                ]
              }
            }
          },
          "then": {
            "required": [
              "topics"
            ],
            "properties": {
              "topics": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/topic"
                },
                "minItems": 1
              },
              "rate_hz": {
                "$ref": "#/$defs/positive"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cmd": {
                "const": "plan.load"
              }
            }
          },
          "then": {
            "required": [
              "plan_id"
            ],
            "properties": {
              "plan_id": {
                "$ref": "#/$defs/plan_id"
              },
              "steps": {
                "$ref": "#/$defs/steps"
              },
              "autostart": {
                "type": "boolean"
              },
              "end": {
                "type": "boolean"
              },
              "replace": {
                "type": "boolean"
              },
              "on_disconnect": {
                "$ref": "#/$defs/on_disconnect"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cmd": {
                "const": "plan.append"
              }
            }
          },
          "then": {
            "required": [
              "plan_id",
              "steps"
            ],
            "properties": {
              "plan_id": {
                "$ref": "#/$defs/plan_id"
              },
              "steps": {
                "$ref": "#/$defs/steps"
              },
              "end": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cmd": {
                "enum": [
                  "plan.start",
                  "plan.pause",
                  "plan.resume",
                  "plan.cancel"
                ]
              }
            }
          },
          "then": {
            "required": [
              "plan_id"
            ],
            "properties": {
              "plan_id": {
                "$ref": "#/$defs/plan_id"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cmd": {
                "const": "plan.status"
              }
            }
          },
          "then": {
            "properties": {
              "plan_id": {
                "$ref": "#/$defs/plan_id"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cmd": {
                "const": "plan.results"
              }
            }
          },
          "then": {
            "required": [
              "plan_id"
            ],
            "properties": {
              "plan_id": {
                "$ref": "#/$defs/plan_id"
              },
              "from_seq": {
                "$ref": "#/$defs/seq"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cmd": {
                "const": "camera.set"
              }
            }
          },
          "then": {
            "properties": {
              "preset": {
                "$ref": "#/$defs/camera_preset"
              },
              "resolution": {
                "$ref": "#/$defs/resolution"
              },
              "fps": {
                "type": "integer",
                "minimum": 1,
                "maximum": 30
              },
              "quality": {
                "type": "number",
                "minimum": 1,
                "maximum": 100
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cmd": {
                "enum": [
                  "module.read",
                  "module.call"
                ]
              }
            }
          },
          "then": {
            "required": [
              "module_id"
            ],
            "properties": {
              "module_id": {
                "$ref": "#/$defs/module_id"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cmd": {
                "const": "module.call"
              }
            }
          },
          "then": {
            "required": [
              "action"
            ],
            "properties": {
              "action": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "args": {
                "type": "object"
              }
            }
          }
        }
      ]
    },
    "response": {
      "type": "object",
      "required": [
        "type",
        "id",
        "ok"
      ],
      "properties": {
        "type": {
          "const": "res"
        },
        "id": {
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "ok": {
          "type": "boolean"
        },
        "next_seq": {
          "$ref": "#/$defs/seq"
        },
        "queue_free": {
          "type": "integer",
          "minimum": 0
        },
        "done_seq": {
          "type": "integer",
          "minimum": 0
        }
      },
      "if": {
        "properties": {
          "ok": {
            "const": false
          }
        }
      },
      "then": {
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "msg"
            ],
            "properties": {
              "code": {
                "$ref": "#/$defs/error_code"
              },
              "msg": {
                "type": "string"
              },
              "next_seq": {
                "$ref": "#/$defs/seq"
              }
            }
          }
        }
      }
    },
    "hello": {
      "type": "object",
      "required": [
        "type",
        "protocol",
        "firmware",
        "name",
        "bot_id",
        "mac",
        "boot_id",
        "geometry",
        "limits",
        "capabilities",
        "modules"
      ],
      "properties": {
        "type": {
          "const": "hello"
        },
        "protocol": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "firmware": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "bot_id": {
          "type": "string"
        },
        "mac": {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$"
        },
        "boot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "sim": {
          "type": "boolean"
        },
        "geometry": {
          "type": "object",
          "required": [
            "wheel_diameter",
            "track_width",
            "ticks_per_rev"
          ],
          "properties": {
            "wheel_diameter": {
              "$ref": "#/$defs/positive"
            },
            "track_width": {
              "$ref": "#/$defs/positive"
            },
            "ticks_per_rev": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "limits": {
          "type": "object",
          "required": [
            "max_linear",
            "max_angular",
            "command_timeout_ms",
            "plan_queue",
            "plan_max_duration_ms",
            "results_buffer",
            "max_clients"
          ],
          "properties": {
            "max_linear": {
              "$ref": "#/$defs/positive"
            },
            "max_angular": {
              "$ref": "#/$defs/positive"
            },
            "command_timeout_ms": {
              "type": "integer",
              "minimum": 50
            },
            "plan_queue": {
              "type": "integer",
              "minimum": 4
            },
            "plan_max_duration_ms": {
              "type": "integer",
              "minimum": 1000
            },
            "results_buffer": {
              "type": "integer",
              "minimum": 4
            },
            "max_clients": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "capabilities": {
          "type": "object",
          "required": [
            "lights",
            "status_leds",
            "topics",
            "step_ops"
          ],
          "properties": {
            "lights": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/light_name"
              }
            },
            "status_leds": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/light_name"
              }
            },
            "status_patterns": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/status_pattern"
              }
            },
            "topics": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/topic"
              }
            },
            "step_ops": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "camera": {
              "$ref": "#/$defs/camera_capability"
            }
          }
        },
        "modules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/module"
          }
        }
      }
    },
    "event": {
      "type": "object",
      "required": [
        "type",
        "evt",
        "t"
      ],
      "properties": {
        "type": {
          "const": "evt"
        },
        "evt": {
          "type": "string"
        },
        "t": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evt": {
                "const": "plan.step_started"
              }
            }
          },
          "then": {
            "required": [
              "plan_id",
              "seq",
              "op",
              "queue_free"
            ],
            "properties": {
              "plan_id": {
                "$ref": "#/$defs/plan_id"
              },
              "seq": {
                "$ref": "#/$defs/seq"
              },
              "queue_free": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evt": {
                "const": "plan.step_done"
              }
            }
          },
          "then": {
            "required": [
              "plan_id",
              "seq",
              "op",
              "result",
              "pose",
              "queue_free"
            ],
            "properties": {
              "plan_id": {
                "$ref": "#/$defs/plan_id"
              },
              "seq": {
                "$ref": "#/$defs/seq"
              },
              "result": {
                "enum": [
                  "ok",
                  "failed"
                ]
              },
              "pose": {
                "$ref": "#/$defs/pose"
              },
              "queue_free": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evt": {
                "const": "plan.done"
              }
            }
          },
          "then": {
            "required": [
              "plan_id",
              "done_seq"
            ],
            "properties": {
              "plan_id": {
                "$ref": "#/$defs/plan_id"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evt": {
                "enum": [
                  "plan.failed",
                  "plan.cancelled"
                ]
              }
            }
          },
          "then": {
            "required": [
              "plan_id",
              "seq",
              "reason"
            ],
            "properties": {
              "plan_id": {
                "$ref": "#/$defs/plan_id"
              },
              "seq": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/seq"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evt": {
                "const": "plan.marker"
              }
            }
          },
          "then": {
            "required": [
              "plan_id",
              "seq",
              "label"
            ],
            "properties": {
              "label": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evt": {
                "const": "plan.paused"
              }
            }
          },
          "then": {
            "required": [
              "plan_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "evt": {
                "const": "motion.stopped"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "enum": [
                  "stop",
                  "command_timeout",
                  "disconnect"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evt": {
                "const": "camera.streaming"
              }
            }
          },
          "then": {
            "required": [
              "active"
            ],
            "properties": {
              "active": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evt": {
                "const": "module.added"
              }
            }
          },
          "then": {
            "required": [
              "module"
            ],
            "properties": {
              "module": {
                "$ref": "#/$defs/module"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evt": {
                "enum": [
                  "module.removed",
                  "module.event"
                ]
              }
            }
          },
          "then": {
            "required": [
              "module_id"
            ],
            "properties": {
              "module_id": {
                "$ref": "#/$defs/module_id"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evt": {
                "const": "module.event"
              }
            }
          },
          "then": {
            "required": [
              "event"
            ],
            "properties": {
              "event": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "telemetry": {
      "type": "object",
      "required": [
        "type",
        "topic",
        "t"
      ],
      "properties": {
        "type": {
          "const": "tlm"
        },
        "topic": {
          "$ref": "#/$defs/topic"
        },
        "t": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "topic": {
                "const": "odom"
              }
            }
          },
          "then": {
            "required": [
              "x",
              "y",
              "yaw",
              "v",
              "w"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "yaw": {
                "type": "number"
              },
              "v": {
                "type": "number"
              },
              "w": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "topic": {
                "const": "encoders"
              }
            }
          },
          "then": {
            "required": [
              "left",
              "right"
            ],
            "properties": {
              "left": {
                "$ref": "#/$defs/wheel"
              },
              "right": {
                "$ref": "#/$defs/wheel"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "topic": {
                "const": "power"
              }
            }
          },
          "then": {
            "required": [
              "percent",
              "voltage"
            ],
            "properties": {
              "percent": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "voltage": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "topic": {
                "const": "net"
              }
            }
          },
          "then": {
            "required": [
              "rssi"
            ],
            "properties": {
              "rssi": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "topic": {
                "const": "status"
              }
            }
          },
          "then": {
            "required": [
              "mode",
              "plan_state"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "idle",
                  "raw",
                  "velocity",
                  "plan"
                ]
              },
              "plan_state": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/plan_state"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "camera_streaming": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "topic": {
                "type": "string",
                "pattern": "^module\\."
              }
            }
          },
          "then": {
            "required": [
              "module_id",
              "values"
            ],
            "properties": {
              "module_id": {
                "$ref": "#/$defs/module_id"
              },
              "values": {
                "type": "object"
              }
            }
          }
        }
      ]
    },
    "wheel": {
      "type": "object",
      "required": [
        "ticks",
        "speed"
      ],
      "properties": {
        "ticks": {
          "type": "integer"
        },
        "speed": {
          "type": "number"
        }
      }
    },
    "module_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,31}$"
    },
    "resolution": {
      "type": "string",
      "pattern": "^[0-9]{2,5}x[0-9]{2,5}$"
    },
    "camera_preset": {
      "enum": [
        "fast",
        "balanced",
        "detail"
      ]
    },
    "module": {
      "type": "object",
      "required": [
        "id",
        "type",
        "version",
        "values",
        "actions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/module_id"
        },
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.]{0,47}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "info": {
          "type": "object"
        }
      }
    },
    "camera_capability": {
      "oneOf": [
        {
          "const": false
        },
        {
          "type": "object",
          "required": [
            "stream_port",
            "stream_path",
            "resolutions",
            "presets",
            "max_fps"
          ],
          "properties": {
            "stream_port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "stream_path": {
              "type": "string"
            },
            "capture_path": {
              "type": "string"
            },
            "resolutions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/resolution"
              }
            },
            "presets": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": [
                  "resolution",
                  "fps",
                  "quality"
                ],
                "properties": {
                  "resolution": {
                    "$ref": "#/$defs/resolution"
                  },
                  "fps": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "quality": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  }
                }
              }
            },
            "max_fps": {
              "type": "integer",
              "minimum": 1
            },
            "privacy_indicator": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
